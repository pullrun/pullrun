# Linux kernel configuration for the Pullrun Apple Virtualization guest.
#
# This is a FRAGMENT meant to be merged on top of an Asahi
# defconfig (or fed to `make localmodconfig` after a
# smoke-boot of the guest). The keys we care about are:
#
#   1. The kernel must boot on the Apple Virtualization
#      guest ABI. That means the Asahi tree, not mainline
#      arm64.
#   2. Virtio for the console (CONFIG_VIRTIO_CONSOLE=y),
#      net (CONFIG_VIRTIO_NET=y), vsock (CONFIG_VIRTIO_VSOCKETS=y),
#      and 9p (CONFIG_VIRTIO_9P / CONFIG_NET_9P for the
#      VirtioFS share of the host store).
#   3. The kernel must be uncompressed ELF at /boot/vmlinux
#      — not a bzImage, not a zImage, not an EFI stub.
#      Apple-Virt's VZLinuxBootLoader::initWithKernelURL:
#      accepts an uncompressed ELF.
#
# Build invocation:
#   make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- \
#        pullrun_defconfig
#   ./scripts/kconfig/merge_config.sh .config path/to/this.file
#   make ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- -j$(nproc) Image

# Apple-Virt virtio devices
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_BLK=y

# 9p / VirtioFS for the host store share
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_NETWORK_FILESYSTEMS=y

# virtio-mmio transport (used by the guest)
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y

# Minimal but usable console + serial
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_VT=y
CONFIG_HVC_DRIVER=y
CONFIG_HVC_IRQ=y
CONFIG_HVC_DCC=y

# Memory + scheduler (defaults are fine; just be explicit)
CONFIG_MMU=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4

# Filesystems (for the initramfs + runtime scratch)
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y

# Networking basics
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=m

# Required by the static pullrun-runtime binary
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Apple-Virt guest ABI
CONFIG_ARM64_16K_PAGES=y
# (Asahi ships this; we don't override it. If you find the
#  guest OOPs on boot, check that the defconfig matches the
#  page size Apple-Virt is emulating.)
